{
  "brand": "criativo DODÔ.",
  "version": "2.0",
  "migrationNote": "v2.0 (2026-07-24): migração semântica — roxo assume todas as funções de cor primária (identidade, CTA, foco, links); laranja passa a cor secundária/apoio. Ver decisões completas no handoff da sessão.",
  "color": {
    "roxo":     { "hex": "#564f94", "proportion": 0.34, "role": "cor-assinatura / primária — superfícies e fundos de destaque, CTA principal, links, foco; é a cor dominante do sistema; aceita texto branco com folga (AAA)" },
    "offwhite": { "hex": "#f1ece5", "proportion": 0.21, "role": "base neutra de leitura / fundo padrão" },
    "amarelo":  { "hex": "#eff857", "proportion": 0.17, "role": "realce / apoio; só texto preto" },
    "preto":    { "hex": "#1d1c1a", "proportion": 0.14, "role": "texto e estrutura (texto universal)" },
    "laranja":  { "hex": "#f85919", "proportion": 0.14, "role": "secundária / apoio — ação secundária e pontuação de alerta; nunca dominante; sempre com texto preto (AA)" },
    "branco":   { "hex": "#ffffff", "proportion": null, "role": "superfície de cartões e campos" }
  },
  "semantic": {
    "bg": "offwhite",
    "surface": "branco",
    "text": "preto",
    "textInverse": "branco",
    "primary": "roxo",
    "primaryText": "branco",
    "primaryHover": "#453f7a",
    "secondary": "laranja",
    "secondaryText": "preto",
    "secondaryHover": "#e04d10",
    "accent": "amarelo",
    "accentText": "preto",
    "link": "roxo",
    "focus": "roxo",
    "danger": "laranja",
    "dangerHintText": "#c0410f"
  },
  "typography": {
    "display": { "family": "Elms Sans", "file": "brand/fonts/ElmsSans.ttf", "weight": 800, "use": "títulos e display" },
    "text": { "family": "Work Sans", "file": "brand/fonts/WorkSans.ttf", "weight": 400, "use": "corpo e interface" },
    "scale": {
      "display": { "size": 64, "line": 60, "weight": 800, "font": "display" },
      "h2": { "size": 40, "line": 44, "weight": 800, "font": "display" },
      "h3": { "size": 22, "line": 28, "weight": 700, "font": "display" },
      "body": { "size": 16, "line": 25, "weight": 400, "font": "text" },
      "label": { "size": 13, "line": 16, "weight": 600, "font": "text", "case": "uppercase", "tracking": "0.08em" }
    }
  },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96] },
  "radius": { "field": 8, "card": 14, "block": 24, "pill": 999 },
  "layout": { "contentMax": 1120, "gridColsDesktop": 12, "gridColsMobile": 4, "gutter": 24, "approach": "mobile-first" },
  "contrast": {
    "preto_on_offwhite": { "ratio": 14.5, "level": "AAA", "use": "texto de corpo" },
    "preto_on_amarelo": { "ratio": 14.8, "level": "AAA", "use": "texto sobre destaque" },
    "branco_on_roxo": { "ratio": 7.1, "level": "AAA", "use": "cor primária — CTA e fundo de assinatura" },
    "roxo_on_offwhite": { "ratio": 6.1, "level": "AA", "use": "texto, links e ação sobre fundo claro" },
    "roxo_on_amarelo": { "ratio": 6.2, "level": "AA", "use": "título sobre destaque" },
    "preto_on_laranja": { "ratio": 5.2, "level": "AA", "use": "cor secundária — apoio e alerta" },
    "branco_on_laranja": { "ratio": 3.3, "level": "AA-large-only", "use": "só título grande (≥24px)" },
    "laranja_on_offwhite": { "ratio": 2.8, "level": "fail-text", "use": "não usar como texto de corpo" },
    "amarelo_on_offwhite": { "ratio": 1.0, "level": "fail-text", "use": "nunca como texto" }
  },
  "logos": {
    "dir": "brand/logos",
    "horizontal": ["horizontal-preto.svg", "horizontal-branco.svg", "horizontal-laranja.svg", "horizontal-roxo.svg", "horizontal-amarelo.svg"],
    "stack": ["stack-preto.svg", "stack-laranja.svg", "stack-roxo.svg", "stack-amarelo.svg"],
    "note": "horizontal-branco.svg sincronizado de frontend/public/horizontal-branco.svg em 2026-07-24 — é a combinação recomendada sobre fundo roxo (7.1:1 AAA). Ainda não existe stack-branco.svg (versão empilhada em branco) — pendente."
  }
}
